generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Story {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  title         String
  description   String?  @db.Text
  content       String?  @db.Text
  category      String
  author        String
  authorId      Int?
  userId        Int?
  cover         String?
  status        String   @default("Ongoing")
  rating        Float    @default(0)
  totalReaders  Int      @default(0)
  views         Int      @default(0)
  likes         Int      @default(0)
  publishedYear Int?
  readingTime   String?  @default("10 min")
  tags          String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isPublished   Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  
  chapters      Chapter[]
  reviews       Review[]
  savedBy       SavedStory[]
  readingProgress ReadingProgress[]
  user          User?    @relation(fields: [userId], references: [id])
}

model Chapter {
  id          Int      @id @default(autoincrement())
  storyId     Int
  title       String
  content     String   @db.Text
  chapterNumber Int
  readingTime String?  @default("5 min")
  wordCount   Int?     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  story       Story    @relation(fields: [storyId], references: [id])
  readingProgress ReadingProgress[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  passwordHash String
  name      String
  role      String   @default("USER")
  bio       String?  @db.Text
  avatar    String?  // Store avatar URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stories         Story[]
  reviews         Review[]
  savedStories    SavedStory[]
  readingProgress ReadingProgress[]
}

model Review {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  rating    Int
  userId    Int
  storyId   Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  story     Story    @relation(fields: [storyId], references: [id])
}

model SavedStory {
  id        Int      @id @default(autoincrement())
  userId    Int
  storyId   Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  story     Story    @relation(fields: [storyId], references: [id])
}

model ReadingProgress {
  id          Int      @id @default(autoincrement())
  userId      Int
  storyId     Int
  chapterId   Int?
  scrollPosition Int    @default(0)
  percentage  Float    @default(0)
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  story       Story    @relation(fields: [storyId], references: [id])
  chapter     Chapter? @relation(fields: [chapterId], references: [id])
}
